modules = ["python-base-3.13", "php-8.4", "nodejs-24"]
[nix]
channel = "stable-25_05"
packages = ["mariadb", "unzip"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Jain Eye Hospital Preview"

[[workflows.workflow]]
name = "Jain Eye Hospital Preview"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash scripts/dev-server.sh"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"
